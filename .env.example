# Copy to .env.local and fill in what you need. Every variable is optional.
# VITE_* values are bundled into the public site: never put secrets here.

# GitHub username for the activity section (defaults to "mevanshbajaj")
VITE_GITHUB_USERNAME=

# Endpoint returning { totalSolved, easySolved, mediumSolved, hardSolved }. "{username}" is replaced by the LeetCode username.
# Leave empty to show difficulty stats only from src/data/problemSolving.ts (hidden while that is null).
VITE_LEETCODE_STATS_URL=

# Form endpoint for the contact form, e.g. https://formspree.io/f/xxxxxxxx
# Leave empty and the form opens the visitor's email app with the message prefilled.
VITE_CONTACT_FORM_ENDPOINT=

# Public URL of your deployed assistant backend, e.g. https://your-site.vercel.app/api/assistant
# Leave empty and the assistant section is hidden in production.
VITE_ASSISTANT_API_URL=

# ---- Server-side only (set in your host's dashboard for api/assistant.ts, NOT in this file's VITE_ section) ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ASSISTANT_ALLOWED_ORIGIN=
